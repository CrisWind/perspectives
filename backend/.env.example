# 复制为 .env 后填写。.env 不会进 git（仓库是公开的，密钥绝不能提交）。

# ---- 模型 ----
# 填了哪家的 KEY 就启用哪家；一家都不填则使用内置模拟模型（只用于联调，内容是假的）。
# 各家都走 OpenAI 兼容接口。*_MODEL 的默认值可能过时，请按各家控制台里的模型名填写。
DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com

MIMO_API_KEY=
# MIMO_MODEL=mimo-v2.6-pro    （另有 mimo-v2.6-flash）
# MIMO_EXTRA_BODY={"thinking":{"type":"enabled"}}   （默认关闭深度思考）

QWEN_API_KEY=
# QWEN_MODEL=qwen-plus

ZHIPU_API_KEY=
# ZHIPU_MODEL=glm-4-plus

MOONSHOT_API_KEY=
# MOONSHOT_MODEL=moonshot-v1-32k

DOUBAO_API_KEY=
# DOUBAO_MODEL=   （豆包必须填推理接入点 ID）

OPENAI_API_KEY=
# OPENAI_MODEL=

# 其他兼容 OpenAI 接口的服务：在这里列名字，再分别提供 名字_API_KEY / 名字_BASE_URL / 名字_MODEL
# LLM_EXTRA_PROVIDERS=myproxy

# 角色发言用哪些模型（逗号分隔，按角色轮流分配）；不填则使用全部已启用的
# PERSONA_PROVIDERS=deepseek,qwen
# 质量引擎、决策卡用哪家；不填则用第一家
# JUDGE_PROVIDER=deepseek
# 强制使用模拟模型
# LLM_MOCK=1

# ---- 联网查证（可选）----
# SEARCH_PROVIDER=tavily     # tavily 或 bocha
# SEARCH_API_KEY=

# ---- 服务 ----
# DB_PATH=data/perspectives.db
# CORS_ORIGINS=*
# ADMIN_TOKEN=        # 设置后，进化管理接口需要请求头 X-Admin-Token

# ---- 辩论参数 ----
# TEAM_SIZE=3  # 不含"未来的自己"
# DEEP_ROUNDS=3
# QUICK_ROUNDS=2
# MAX_RETRIES=2       # 质量引擎打回后最多重写几次
# CROSS_PARALLEL=0            # 交叉质询每批同时发言的角色数；0 表示整轮一起（最快），1 表示逐个发言（最慢）
# MIN_CHALLENGES=3           # 每场至少保留几条针对用户倾向的挑战
# QUICK_REPLAY_DELAY=0.6     # 快速模式回放缓存时每条发言的间隔（秒）
